#!/usr/bin/env bash

# - This script runs a in floating pane
# - Inherits the cwd from the source pane
# - Takes stdin from the source pane

read -r src_pane window_id src_cmd < <(tmux display -p -t '{last}' '#{pane_id} #{window_id} #{pane_current_command}')

# Splits "path[:line[:col]]".
strip_locus() {
    REPLY_PATH="$1"
    REPLY_LINE=""
    REPLY_COL=""
    if [[ "$1" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        REPLY_PATH="${BASH_REMATCH[1]}"
        REPLY_LINE="${BASH_REMATCH[2]}"
        REPLY_COL="${BASH_REMATCH[3]}"
    elif [[ "$1" =~ ^(.+):([0-9]+)$ ]]; then
        REPLY_PATH="${BASH_REMATCH[1]}"
        REPLY_LINE="${BASH_REMATCH[2]}"
    fi
}

files=()
while read -r line; do
    strip_locus "$line"
    p="${REPLY_PATH/#\~/$HOME}"
    # -I: to exclude binary files
    if [[ -f "$p" ]] && grep -Iq . "$p"; then
        files+=("$line")
    fi
done < <(tr -s ' \t' '\n' | awk 'NF && !seen[$0]++')

# Why: awk '!seen[$0]++'
# this sorts keeping the original order.
# - '++' is a post-increment
# - !seen[apple]++ == 0 == !0 == true  (awk prints the line)
# - !seen[apple]++ == 1 == !1 == false (awk does not print the line)

((${#files[@]})) || {
    tmux display-message "no files found"
    exit 0
}

if ! choice="$(printf '%s\n' "${files[@]}" | fzf --layout=reverse)"; then
    exit 0
fi

strip_locus "$choice"
p="${REPLY_PATH/#\~/$HOME}"
[[ -f "$p" ]] || exit 0
printf -v q '%q' "$p"

nvim_pane="$(tmux list-panes -t "$window_id" -F '#{pane_id} #{pane_current_command}' | awk '$2 == "nvim" { print $1; exit }')"

if [[ -n "$nvim_pane" ]]; then
    # Route through fnameescape() so spaces/%/# in the path can't confuse :edit.
    vim_p="${p//\'/\'\'}"
    tmux send-keys -t "$nvim_pane" Escape
    tmux send-keys -t "$nvim_pane" ":execute 'edit ' . fnameescape('$vim_p')" Enter
    if [[ -n "$REPLY_LINE" ]]; then
        tmux send-keys -t "$nvim_pane" ":call cursor($REPLY_LINE, ${REPLY_COL:-1})" Enter
    fi
    tmux select-pane -t "$nvim_pane"
    exit 0
fi

if [[ "$src_cmd" =~ ^(sh|bash|zsh|fish)$ ]]; then
    if [[ -n "$REPLY_LINE" ]]; then
        tmux send-keys -t "$src_pane" C-a C-k "nvim -c 'call cursor($REPLY_LINE, ${REPLY_COL:-1})' $q" Enter
    else
        tmux send-keys -t "$src_pane" C-a C-k "nvim $q" Enter
    fi
else
    tmux display-message "current prompt busy with '$src_cmd'"
fi
