#!/usr/bin/env bash
PATH="${PATH}:/opt/homebrew/bin:${HOME}/Syncthing/SYNC_STUFF/githome/private_dotfiles/topics/scripts-private/bin"

# calling this does an initial update if required
tes-ip-or-node "dummy-value" >/dev/null

out="$(
    rg -oF -f <(tr -s '[:space:]' '\n' <"$HOME/.local/state/.tcdn-server-map" | grep .) | awk '!seen[$0]++' | while read -r line; do
        tes-ip-or-node "$line"
    done | awk '!seen[$0]++' | column -t -l 2
)"

if [[ -n "$out" ]]; then
    choice="$(printf '%s\nCOPY-ALL\nCOPY-NAMES\nCOPY-IPS' "$out" | fzf --reverse)"

    [[ -n "$choice" ]] || exit

    case "$choice" in
    "COPY-ALL")
        printf '%s' "$out" | tmux load-buffer -w -
        ;;
    "COPY-NAMES")
        names=$(awk '{print $1}' <<<"$out")
        printf '%s' "$names" | tmux load-buffer -w -
        ;;
    "COPY-IPS")
        ips=$(awk '{for (i=2; i<=NF; i++) print $i}' <<<"$out")
        printf '%s' "$ips" | tmux load-buffer -w -
        ;;
    *)
        choice2="$(tr -s ' ' '\n' <<<"$choice" | sort | fzf --reverse)"
        [[ -n "$choice2" ]] || exit
        printf '%s' "$choice2" | tmux load-buffer -w -
        ;;
    esac
else
    tmux display-message "No server/IP found."
fi
